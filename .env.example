# Copy to .env (local) and add the same variables in Vercel > Project > Settings > Environment Variables.
# NEVER commit .env — it is ignored by .gitignore.

# Supabase (Project Settings > API). Service role key is server-only, never use it in the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp notification to the venue owner (demo: CallMeBot, https://www.callmebot.com/blog/free-api-whatsapp-messages/)
WHATSAPP_OWNER_PHONE=+528441234567
CALLMEBOT_API_KEY=

# Optional: point the frontend to another API origin (default: same-origin /api)
# VITE_API_URL=
